NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# From your Plaid Dashboard's Keys page.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production — see https://plaid.com/docs/guides/environments/
PLAID_ENV=sandbox
# Where Plaid delivers webhooks (e.g. https://yourapp.com/api/webhooks/plaid).
PLAID_WEBHOOK_URL=
# Where OAuth banks (Chase, Bank of America, ...) return the user when Link
# can't use a popup, e.g. https://yourapp.com/settings/bank-return. Must also
# be added under Allowed redirect URIs in Plaid's dashboard.
PLAID_REDIRECT_URI=
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Authenticates Vercel's own cron requests to /api/cron/*. Generate with:
# openssl rand -hex 32
CRON_SECRET=

# --- Optional ---

# Identifies the operator of THIS instance on the /privacy, /terms, and
# /security pages. Leave all three unset and those pages show a clear
# "not configured" placeholder instead of someone else's identity — set all
# three or none. See docs/SELF_HOSTING.md.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=

# Where users can get this instance's source code (shown as "Source" in the
# app). The AGPL requires it if you run a modified copy: point it at yours.
SOURCE_CODE_URL=

# Restricts signup to specific emails/domains, comma-separated
# (jimmy@cheese.com,*@yourcompany.com). Leave unset for open signup.
SIGNUP_ALLOWLIST=

# If this instance sits behind a single trusted reverse proxy (e.g. one doing
# client-certificate auth) and you want to reject direct requests that bypass
# it, set this to that proxy's IP. Leave unset to skip the check. The proxy
# should also set an X-Client-IP header (see docs/SELF_HOSTING.md §6).
ALLOWED_PROXY_IP=
